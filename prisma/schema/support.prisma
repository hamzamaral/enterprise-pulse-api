enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  /// Waiting on the requester; the resolution clock is paused.
  WAITING
  RESOLVED
  CLOSED
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  REOPENED
  RATED
}

/// Destek kategorisi: new tickets are routed to the default assignee.
model TicketCategory {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  name              String
  description       String?
  defaultAssigneeId String?  @db.Uuid
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id])
  defaultAssignee User?    @relation("TicketCategoryDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  tickets         Ticket[]

  @@unique([companyId, name])
  @@map("ticket_categories")
}

/// SLA targets in calendar hours, one row per priority.
model TicketSlaPolicy {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @db.Uuid
  priority           TicketPriority
  firstResponseHours Int
  resolutionHours    Int
  updatedAt          DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, priority])
  @@map("ticket_sla_policies")
}

/// Destek talebi, e.g. TKT-2026-000001.
model Ticket {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  number              String
  subject             String
  description         String
  categoryId          String?        @db.Uuid
  priority            TicketPriority @default(MEDIUM)
  status              TicketStatus   @default(OPEN)
  requesterId         String         @db.Uuid
  assigneeId          String?        @db.Uuid
  firstResponseDueAt  DateTime
  /// Moves forward by the time spent in WAITING.
  resolutionDueAt     DateTime
  firstRespondedAt    DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  /// Start of the current WAITING period.
  pausedAt            DateTime?
  pausedMinutes       Int            @default(0)
  /// The requester's rating after resolution, 1-5.
  satisfactionRating  Int?
  satisfactionComment String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  category  TicketCategory? @relation(fields: [categoryId], references: [id])
  requester User            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments  TicketComment[]
  events    TicketEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([requesterId])
  @@index([assigneeId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  /// Internal notes are visible to support agents only.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketCommentAuthor", fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @db.Uuid
  actorId   String?         @db.Uuid
  type      TicketEventType
  fromValue String?
  toValue   String?
  createdAt DateTime        @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketEventActor", fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}
