model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  locale           String    @default("tr")
  isActive         Boolean   @default(true)
  isSuperAdmin     Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  memberships           UserCompany[]
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  notifications         Notification[]
  employees             Employee[]
  assignmentsGiven      AssetAssignment[]     @relation("AssignmentAssignedBy")
  assignmentsReturned   AssetAssignment[]     @relation("AssignmentReturnedBy")
  stockMovements        StockMovement[]       @relation("StockMovementCreatedBy")
  stockCounts           StockCount[]          @relation("StockCountCreatedBy")
  assetCounts           AssetCount[]          @relation("AssetCountCreatedBy")
  assetCountScans       AssetCountLine[]      @relation("AssetCountLineFoundBy")
  attendanceEdits       AttendanceRecord[]    @relation("AttendanceUpdatedBy")
  ledgerEntries         PartnerLedgerEntry[]  @relation("LedgerEntryCreatedBy")
  purchaseRequests      PurchaseRequest[]     @relation("PurchaseRequestRequestedBy")
  supplierQuotes        SupplierQuote[]       @relation("SupplierQuoteCreatedBy")
  purchaseOrders        PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  approvedOrders        PurchaseOrder[]       @relation("PurchaseOrderApprovedBy")
  goodsReceipts         GoodsReceipt[]        @relation("GoodsReceiptCreatedBy")
  purchaseInvoices      PurchaseInvoice[]     @relation("PurchaseInvoiceCreatedBy")
  salesQuotes           SalesQuote[]          @relation("SalesQuoteCreatedBy")
  salesOrders           SalesOrder[]          @relation("SalesOrderCreatedBy")
  approvedSalesOrders   SalesOrder[]          @relation("SalesOrderApprovedBy")
  deliveryNotes         DeliveryNote[]        @relation("DeliveryNoteCreatedBy")
  salesInvoices         SalesInvoice[]        @relation("SalesInvoiceCreatedBy")
  salesReturns          SalesReturn[]         @relation("SalesReturnCreatedBy")
  treasuryTxs           TreasuryTransaction[] @relation("TreasuryTxCreatedBy")
  partnerPayments       PartnerPayment[]      @relation("PaymentCreatedBy")
  chequeEvents          ChequeEvent[]         @relation("ChequeEventCreatedBy")
  ownedLeads            Lead[]                @relation("LeadOwner")
  createdLeads          Lead[]                @relation("LeadCreatedBy")
  ownedOpportunities    Opportunity[]         @relation("OpportunityOwner")
  createdOpportunities  Opportunity[]         @relation("OpportunityCreatedBy")
  crmActivities         CrmActivity[]         @relation("CrmActivityOwner")
  createdCrmActivities  CrmActivity[]         @relation("CrmActivityCreatedBy")
  paidExpenseReports    ExpenseReport[]       @relation("ExpenseReportPaidBy")
  createdExpenseReports ExpenseReport[]       @relation("ExpenseReportCreatedBy")

  @@map("users")
}

/// Company membership. A user can work for several companies; one of them is the default.
model UserCompany {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  companyId       String   @db.Uuid
  defaultBranchId String?  @db.Uuid
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultBranch Branch? @relation(fields: [defaultBranchId], references: [id])

  @@unique([userId, companyId])
  @@map("user_companies")
}

/// companyId = null means a system role shared by every company.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company       Company?         @relation(fields: [companyId], references: [id])
  permissions   RolePermission[]
  userRoles     UserRole[]
  workflowSteps WorkflowStep[]

  @@unique([companyId, code])
  @@map("roles")
}

/// Permission code format: "<module>:<action>", e.g. "users:create", "asset:assign".
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Roles are granted per company.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId])
  @@index([userId, companyId])
  @@map("user_roles")
}

/// Refresh tokens are stored hashed and rotated on every use.
/// All tokens issued from the same login share a familyId so that reuse of an old token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
