enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  /// Manages tasks and members like the project manager.
  LEAD
  MEMBER
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Proje: tasks on a kanban board, time logged by members and its cost against the budget.
model Project {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  number       String
  name         String
  description  String?
  /// Customer the project is delivered for.
  partnerId    String?       @db.Uuid
  managerId    String        @db.Uuid
  status       ProjectStatus @default(PLANNED)
  startDate    DateTime?     @db.Date
  dueDate      DateTime?     @db.Date
  completedAt  DateTime?
  /// Cost budget in the company currency (labour + expenses).
  budgetAmount Decimal?      @db.Decimal(18, 2)
  /// Approved / paid expense reports charged to the project; kept up to date by the expenses module.
  expenseCost  Decimal       @default(0) @db.Decimal(18, 2)
  createdById  String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  partner        BusinessPartner? @relation(fields: [partnerId], references: [id])
  manager        Employee         @relation("ProjectManager", fields: [managerId], references: [id])
  createdBy      User             @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  members        ProjectMember[]
  tasks          ProjectTask[]
  timeEntries    TimeEntry[]
  expenseReports ExpenseReport[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("projects")
}

model ProjectMember {
  id         String            @id @default(uuid()) @db.Uuid
  projectId  String            @db.Uuid
  employeeId String            @db.Uuid
  role       ProjectMemberRole @default(MEMBER)
  /// Cost of one hour in the company currency; copied onto each time entry.
  hourlyCost Decimal?          @db.Decimal(18, 2)
  createdAt  DateTime          @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([projectId, employeeId])
  @@index([employeeId])
  @@map("project_members")
}

model ProjectTask {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  /// Sequential within the project ("#12").
  taskNo         Int
  title          String
  description    String?
  status         ProjectTaskStatus   @default(TODO)
  priority       ProjectTaskPriority @default(MEDIUM)
  assigneeId     String?             @db.Uuid
  dueDate        DateTime?           @db.Date
  estimatedHours Decimal?            @db.Decimal(8, 2)
  /// Order inside its kanban column.
  sortOrder      Int                 @default(0)
  completedAt    DateTime?
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Employee?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User        @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])
  timeEntries TimeEntry[]

  @@unique([projectId, taskNo])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("project_tasks")
}

/// Hours an employee worked on a project (optionally a task) on one day.
model TimeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  projectId   String   @db.Uuid
  taskId      String?  @db.Uuid
  employeeId  String   @db.Uuid
  workDate    DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  description String?
  /// hours × the member's hourly cost at the time of entry, company currency.
  costAmount  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  project  Project      @relation(fields: [projectId], references: [id])
  task     ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee Employee     @relation(fields: [employeeId], references: [id])

  @@index([companyId, workDate])
  @@index([projectId, workDate])
  @@index([employeeId, workDate])
  @@map("time_entries")
}
