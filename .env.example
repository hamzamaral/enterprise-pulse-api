NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
# Used in e-mail links (password reset etc.)
WEB_APP_URL=http://localhost:5173

DATABASE_URL=postgresql://erp:erp@localhost:5432/enterprise_pulse?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=erpadmin
S3_SECRET_KEY=erpadmin123
S3_BUCKET=enterprise-pulse

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="EnterprisePulse <no-reply@enterprisepulse.dev>"
